# ── BAM HVAC IOP — frontend build environment ──────────────────────────
# BUILD-TIME (Vite) variables. In Docker they are passed as --build-arg;
# for local `npm run dev` copy this to `.env.local`.

# Backend API base. The client appends the resource path; keep /api/v1.
VITE_INVENTORY_API_URL=http://localhost:8020/api/v1

# Standalone build: boot straight into the accelerator with no login.
VITE_STANDALONE_ACCELERATOR=true
