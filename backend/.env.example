# ── BAM HVAC IOP — backend environment ─────────────────────────────────
# Copy to `.env` for local dev, or set these as App Service application
# settings in production. Never commit the real .env.

# Database. Omit / leave the SQLite default for zero-config local dev.
# Production Postgres (asyncpg):
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=sqlite+aiosqlite:///./inventory.db

# Seed the deterministic demo dataset on first startup when tables are empty.
SEED_ON_STARTUP=true

# CORS — the frontend origin(s). "*" is fine for a standalone demo.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Sage agent (Claude via Azure AI Foundry). Optional — without these the
# assistant falls back to the deterministic rule-based engine.
ANTHROPIC_FOUNDRY_KEY=
ANTHROPIC_FOUNDRY_URL=
ANTHROPIC_AGENT_MODEL=claude-haiku-4-5
